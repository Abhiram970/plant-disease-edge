# ---- Models / weights / exports (never commit; too big, not the contribution) ----
*.pth
*.pt
*.onnx
*.tflite
*.ckpt
*.safetensors
models/

# ---- Data & embedding caches (live on Kaggle Datasets, not git) ----
data/
dataset_cleaned/
*.parquet
*.npy
*.npz
embeddings/
cache/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/

# ---- Secrets / creds ----
.env
*.key
kaggle.json
.cache/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# run logs: ignored anywhere EXCEPT the curated evidence trail in logs/
*.log
!logs/*.log

# results/ is a TRACKED archive of every experiment output, so collaborators and reviewers can read
# the numbers without re-running anything. Only the exported model graphs are excluded (~1.7 GB, and
# regenerable from the benchmark script).
results/onnx/
results/**/*.onnx
docs/paper/submission/
