# ---- Models / weights / exports (never commit; too big, not the contribution) ----
*.pth
*.pt
*.onnx
*.tflite
*.ckpt
*.safetensors
models/

# ---- Data & embedding caches (live on Kaggle Datasets, not git) ----
data/
dataset_cleaned/
*.parquet
*.npy
*.npz
embeddings/
cache/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/

# ---- Secrets / creds ----
.env
*.key
kaggle.json
.cache/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/

*.log

# results/ is a TRACKED archive of every experiment output, so collaborators and reviewers can read
# the numbers without re-running anything. Only the exported model graphs are excluded (~1.7 GB, and
# regenerable from the benchmark script).
results/onnx/
results/**/*.onnx
docs/paper/submission/

# build artifacts -- regenerate with scripts/build_pdf.py / build_submission.py
docs/paper/build/
docs/paper/compag_submission.zip
docs/paper/compag_submission/

# ---- Archive lives OUTSIDE the repo (../plant-disease-edge-archive) ----
# Listed only so a stray copy inside the tree is never committed.
plant-disease-edge-archive/
_archive/

# ---- LaTeX intermediates (the .tex sources and the built PDF are tracked; the rest is noise) ----
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.abs
*.synctex.gz

# ---- Audit workspaces: review evidence, not source. The ledger is docs/paper/AUDIT_HISTORY.md ----
docs/paper/review_*/
docs/paper/review_results/

# Zenodo deposit build output -- regenerate with scripts/prepare_zenodo_archive.py
dist/
