# Copy to .env and fill in.  .env is git-ignored — never commit your real key.
#   cp .env.example .env

# --- Lava (OpenAI-compatible proxy) — used for descriptor generation (Phase A2) ---
LAVA_API_KEY=paste_your_lava_spend_key_here
LAVA_BASE_URL=https://api.lava.so/v1
LAVA_MODEL=anthropic/claude-sonnet-4-6      # best quality/$ for descriptors (~$0.013 each)

# --- Data location bridge (reuse the existing run_all.py build; no re-download) ---
PDE_DATASET_DIR=C:\kaggle\working\exp_data  # folder of <Crop>___<Disease>/*.jpg
PDE_DATA_ROOT=C:\kaggle\working             # manifest.csv + results/ land here

# --- Optional: native Anthropic SDK instead of Lava (needs a direct Anthropic key) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
